<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC">

    <!-- SCROLLABLE HOME CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="78dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:background="#FFFFFF">

                <!-- PROFILE -->
                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_foreground"
                    android:contentDescription="Profile" />

                <!-- TRIPMATE -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Tripmate"
                    android:textColor="#087F5B"
                    android:textSize="31sp"
                    android:textStyle="bold" />

                <!-- SEARCH ICON -->
                <TextView
                    android:id="@+id/homeSearchIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#087F5B"
                    android:textSize="30sp" />

            </LinearLayout>


            <!-- MAIN CONTENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="30dp">

                <!-- WHERE TO NEXT -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Where to next?"
                    android:textColor="#172033"
                    android:textSize="28sp" />

                <!-- SEARCH BAR -->
                <LinearLayout
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="@drawable/bg_home_search">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="⌕"
                        android:textColor="#52615B"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Search destinations, hotels..."
                        android:textColor="#52615B"
                        android:textSize="18sp" />

                </LinearLayout>


                <!-- UPCOMING TRIP TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp"
                    android:text="Upcoming Trip"
                    android:textColor="#3D4A46"
                    android:textSize="21sp" />

                <!-- UPCOMING TRIP CARD -->
                <FrameLayout
                    android:id="@+id/upcomingTripCard"
                    android:layout_width="match_parent"
                    android:layout_height="330dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_trip_card">

                    <ImageView
                        android:id="@+id/upcomingTripImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        android:src="@drawable/santorini"
                        android:contentDescription="Upcoming trip" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#45000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="16dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="◷  In 3 Days"
                        android:textColor="#087F5B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_trip_badge" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Escape to Goa"
                            android:textColor="#FFFFFF"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="●  Baga Beach  •  4 Nights"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                    </LinearLayout>

                </FrameLayout>


                <!-- QUICK SERVICES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:orientation="horizontal">

                    <!-- FLIGHTS -->
                    <LinearLayout
                        android:id="@+id/flightsOption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:gravity="center"
                            android:text="✈"
                            android:textColor="#4F7568"
                            android:textSize="28sp"
                            android:background="@drawable/bg_service_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Flights"
                            android:textColor="#47534F"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- HOTELS -->
                    <LinearLayout
                        android:id="@+id/hotelsOption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:gravity="center"
                            android:text="▣"
                            android:textColor="#4F7568"
                            android:textSize="28sp"
                            android:background="@drawable/bg_service_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Hotels"
                            android:textColor="#47534F"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- CABS -->
                    <LinearLayout
                        android:id="@+id/cabsOption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:gravity="center"
                            android:text="▣"
                            android:textColor="#4F7568"
                            android:textSize="28sp"
                            android:background="@drawable/bg_service_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Cabs"
                            android:textColor="#47534F"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- TRAINS -->
                    <LinearLayout
                        android:id="@+id/trainsOption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:gravity="center"
                            android:text="▣"
                            android:textColor="#4F7568"
                            android:textSize="28sp"
                            android:background="@drawable/bg_service_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Trains"
                            android:textColor="#47534F"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- POPULAR DESTINATIONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:orientation="vertical">

                    <!-- TITLE ROW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Popular Destinations"
                            android:textColor="#26332F"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/seeAllDestinations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="See all"
                            android:textColor="#087F5B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- HORIZONTAL DESTINATION CARDS -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- MANALI -->
                            <LinearLayout
                                android:id="@+id/manaliCard"
                                android:layout_width="250dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_destination_card">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="175dp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/santorini"
                                    android:contentDescription="Manali destination" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Manali"
                                        android:textColor="#172033"
                                        android:textSize="20sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="Himachal Pradesh"
                                        android:textColor="#72807A"
                                        android:textSize="13sp" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="30dp"
                                            android:gravity="center"
                                            android:paddingStart="12dp"
                                            android:paddingEnd="12dp"
                                            android:text="Mountains"
                                            android:textColor="#087F5B"
                                            android:textSize="12sp"
                                            android:background="@drawable/bg_destination_tag" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="30dp"
                                            android:layout_marginStart="8dp"
                                            android:gravity="center"
                                            android:paddingStart="12dp"
                                            android:paddingEnd="12dp"
                                            android:text="Snow"
                                            android:textColor="#087F5B"
                                            android:textSize="12sp"
                                            android:background="@drawable/bg_destination_tag" />

                                    </LinearLayout>

                                </LinearLayout>

                            </LinearLayout>

                            <!-- BALI -->
                            <LinearLayout
                                android:id="@+id/baliCard"
                                android:layout_width="250dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical"
                                android:background="@drawable/bg_destination_card">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="175dp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/bali"
                                    android:contentDescription="Bali destination" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Bali"
                                        android:textColor="#172033"
                                        android:textSize="20sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="Indonesia"
                                        android:textColor="#72807A"
                                        android:textSize="13sp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>


                <!-- TRAVEL INSPIRATION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:orientation="vertical">

                    <!-- TITLE ROW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Travel Inspiration"
                            android:textColor="#26332F"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/seeAllInspiration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="See all"
                            android:textColor="#087F5B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- INSPIRATION CARD 1 -->
                    <LinearLayout
                        android:id="@+id/inspirationCard1"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:background="@drawable/bg_inspiration_card">

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/santorini"
                            android:contentDescription="Travel inspiration" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Top places to visit this year"
                                android:textColor="#172033"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Discover beautiful destinations and create unforgettable memories."
                                android:textColor="#72807A"
                                android:textSize="12sp"
                                android:maxLines="2" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:text="›"
                            android:textColor="#087F5B"
                            android:textSize="24sp" />

                    </LinearLayout>


                    <!-- INSPIRATION CARD 2 -->
                    <LinearLayout
                        android:id="@+id/inspirationCard2"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:background="@drawable/bg_inspiration_card">

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bali"
                            android:contentDescription="Travel inspiration" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="How to plan the perfect getaway"
                                android:textColor="#172033"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Simple tips to make your next trip easy and stress-free."
                                android:textColor="#72807A"
                                android:textSize="12sp"
                                android:maxLines="2" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:text="›"
                            android:textColor="#087F5B"
                            android:textSize="24sp" />

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- FIXED BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="10dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="42dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="⌂"
                android:textColor="#087F5B"
                android:textSize="24sp"
                android:background="@drawable/bg_nav_selected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#087F5B"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- TRIPS -->
        <LinearLayout
            android:id="@+id/navTrips"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="42dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="◉"
                android:textColor="#52615B"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trips"
                android:textColor="#52615B"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- DESTINATIONS -->
        <LinearLayout
            android:id="@+id/navDestinations"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="42dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="⌘"
                android:textColor="#52615B"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Destinations"
                android:textColor="#52615B"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="42dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="♙"
                android:textColor="#52615B"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#52615B"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>