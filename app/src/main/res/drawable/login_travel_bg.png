_invite_credit_amount_usd\":100,\"check_professional_workspace_owner_domain\":true,\"run_grant_sentinel_check\":true,\"max_workspace_member_count\":5,\"max_total_num_credits\":12500,\"max_total_credit_amount_usd\":500,\"offer_text\":\"Get {amount} in credits for every member who starts using Codex.\",\"check_max_workspace_redemption_count\":true,\"per_eligible_invite_num_credits\":2500,\"terms_url\":\"https://help.openai.com/en/articles/20001150\",\"check_workspace_owner\":true,\"check_workspace_business_free_trial\":true,\"exclude_usage_based_seats_from_paid_business_seat_check\":true,\"terms_text\":\"View Terms\",\"check_paid_business_seat\":true,\"check_fraudulent_organization\":true,\"fine_print_text\":\"{amount} credit eligibility requires that the user be added as a Codex PAYG seat to a verified-domain organization and have used Codex on or before April 30, not have had a paid business seat within 90 days, not have redeemed the promotion before, not have been associated with a fraudulent organization, and be in a workspace with a total cap of no more than {maxAmount}.\"},\"is_device_based\":false,\"passed\":false},\"2688454279\":{\"name\":\"2688454279\",\"rule_id\":\"35Dg2O0a0xbncUKLdHChWi:100.00:4-35Dg2Ml7yf1STvcPCzGEDg\",\"secondary_exposures\":[{\"gate\":\"3214226695\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3942202898\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"4131374858\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"240634109\",\"gateValue\":\"false\",\"ruleID\":\"3Bfrw3Sig4w6HIXSyIYF34\"},{\"gate\":\"2019673878\",\"gateValue\":\"true\",\"ruleID\":\"6dwDONMgoLGrX38sVDO1kl:100.00:5\"},{\"gate\":\"2650520192\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"242711730\",\"gateValue\":\"true\",\"ruleID\":\"7tGAs5pMfH3PdHCi99HCaB:100.00:9\"}],\"version\":174,\"id_type\":\"userID\",\"value\":{\"home_takeover_animation_enabled\":false,\"rollout_policy\":\"available_default\",\"incall_banner_enable